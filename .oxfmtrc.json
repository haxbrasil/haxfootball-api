{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "useTabs": false,
  "tabWidth": 2,
  "printWidth": 80,
  "singleQuote": false,
  "jsxSingleQuote": false,
  "quoteProps": "as-needed",
  "trailingComma": "none",
  "semi": true,
  "arrowParens": "always",
  "bracketSameLine": false,
  "bracketSpacing": true,
  "ignorePatterns": [
    "node_modules",
    "data",
    "openapi.yaml",
    "bun.lock",
    "src/features/live-state/_graphql/generated.ts",
    "drizzle/meta/*.json",
    "drizzle/*.sql"
  ]
}
