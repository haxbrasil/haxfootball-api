{
  "name": "haxfootball-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "jobs:work": "bun src/jobs.ts work",
    "jobs:enqueue": "bun src/jobs.ts enqueue",
    "jobs:run": "bun src/jobs.ts run",
    "jobs:list": "bun src/jobs.ts list",
    "jobs:retry": "bun src/jobs.ts retry",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "graphql:generate": "graphql-codegen --config codegen.ts",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "test": "bun run test:e2e && bun run test:internal",
    "test:e2e": "bun run test:e2e:boundaries && bash scripts/test-e2e.sh",
    "test:e2e:boundaries": "bun scripts/check-e2e-boundaries.ts",
    "test:internal": "bun test test/internal",
    "openapi:generate": "APP_API_KEY=openapi-generation JWT_SECRET=openapi-generation R2_ENDPOINT=https://example.com R2_ACCESS_KEY_ID=openapi-generation R2_SECRET_ACCESS_KEY=openapi-generation bun scripts/generate-openapi.ts",
    "openapi:check": "tmp_dir=$(mktemp -d); trap 'rm -rf \"$tmp_dir\"' EXIT; APP_API_KEY=openapi-generation JWT_SECRET=openapi-generation R2_ENDPOINT=https://example.com R2_ACCESS_KEY_ID=openapi-generation R2_SECRET_ACCESS_KEY=openapi-generation bun scripts/generate-openapi.ts \"$tmp_dir/openapi.yaml\" && diff -u openapi.yaml \"$tmp_dir/openapi.yaml\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1045.0",
    "@elysiajs/jwt": "^1.4.2",
    "@elysiajs/openapi": "^1.4.15",
    "@sinclair/typebox": "^0.34.49",
    "commander": "^14.0.3",
    "drizzle-orm": "~0.44.5",
    "elysia": "^1.4.28",
    "graphql": "16.14.2",
    "graphql-yoga": "^5.21.2"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^7.1.3",
    "@graphql-codegen/typescript": "^6.0.2",
    "@graphql-codegen/typescript-resolvers": "^6.0.2",
    "@types/bun": "^1.2.0",
    "better-sqlite3": "^12.10.0",
    "drizzle-kit": "~0.31.4",
    "oxfmt": "^0.57.0",
    "oxlint": "^1.72.0",
    "typescript": "^5.8.0",
    "yaml": "^2.9.0"
  },
  "packageManager": "bun@1.3.13"
}
